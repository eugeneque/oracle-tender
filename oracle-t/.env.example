# ORACLE-T — пример конфигурации окружения.
# Скопировать в .env и заполнить реальными значениями. .env не должен попадать в git.

# --- База данных ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oraclet
POSTGRES_USER=oraclet
POSTGRES_PASSWORD=change-me

# --- Приложение ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Аутентификация ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Bootstrap первого администратора ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_FULL_NAME=Администратор системы

# --- Сбор тендеров (Этап 2) ---
# Опрос источников — 2 раза в день, утро и обед (раздел 4.1 ТЗ). Формат "HH:MM".
SCHEDULER_ENABLED=true
SCHEDULER_MORNING_TIME=09:00
SCHEDULER_AFTERNOON_TIME=14:00
# Повторные попытки при ошибке загрузки (раздел 5.1 ТЗ)
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BACKOFF_BASE=2.0

# --- Пополнение справочника продукции из внешних источников (раздел 5.3 ТЗ) ---
# ФГИС работает не как тендерная площадка «всё подряд», а двумя триггерами: ревалидация
# сохранённых карточек типов СИ по расписанию (настройки ниже) и поиск по событию из модуля
# сопоставления — тот идёт вне расписания, через очередь, и настройки не требует.
FGIS_REVALIDATION_ENABLED=true
# Раз в сутки: «Описание типа» переиздаётся приказами Росстандарта — событие месяцев, а не
# часов, и чаще ходить в нестабильный сервис ФГИС незачем.
FGIS_REVALIDATION_TIME=04:00
# Сколько карточек ставить в очередь за один плановый прогон: каждый запрос к ФГИС — до 45
# секунд, весь справочник за одну ночь не обойти.
FGIS_REVALIDATION_BATCH=100

# Каталог собственной продукции МИРТЕК меняется редко — еженедельного обхода достаточно.
# MIRTEK_CATALOG_SYNC_WEEKDAY в формате cron: 0 — понедельник.
MIRTEK_CATALOG_SYNC_ENABLED=true
MIRTEK_CATALOG_SYNC_WEEKDAY=0
MIRTEK_CATALOG_SYNC_TIME=05:00

# --- Документы тендеров (Этап 3) ---
STORAGE_DIR=storage
# OCR-fallback для сканов PDF без текстового слоя (раздел 5.2 ТЗ). Требует системный
# бинарник tesseract с языковыми пакетами rus/eng (в Docker-образе ставится автоматически).
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_RESOLUTION=300

# Ключ и Folder ID Yandex AI Studio (раздел 5.4 ТЗ) сюда НЕ добавляются — по запросу заказчика
# они настраиваются из интерфейса (Настройки → Интеграции, роль «Администратор») и хранятся в
# БД (`yandex_ai_studio_settings`), а не в .env — см. app/services/yandex_ai_service.py.

# --- Почтовые уведомления (Этап 10, раздел 5.8 ТЗ) ---
# Ящик-отправитель. В отличие от ключа Yandex AI Studio, задаётся здесь: он один на
# установку и не должен теряться при пересоздании базы. Значения переносятся в БД при
# ПЕРВОМ запуске; дальше настройки правятся в интерфейсе (Настройки → Уведомления, роль
# «Администратор») и .env больше не читается — чтобы правки адресатов не откатывались при
# перезапуске. Перенастроить из .env заново: очистить поле «SMTP-сервер» в интерфейсе.
NOTIFY_ENABLED=true
NOTIFY_SMTP_HOST=smtp.example.ru
# Два рабочих варианта: 465 + ssl (соединение сразу в TLS) или 587 + starttls.
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_SECURITY=ssl
NOTIFY_SMTP_USERNAME=noreply@example.ru
NOTIFY_SMTP_PASSWORD=change-me
# Пусто — берётся NOTIFY_SMTP_USERNAME.
NOTIFY_FROM_ADDRESS=
# Получатели писем по тендерам и, отдельно, получатели писем о критических ошибках.
# Через запятую. Пока пусто — триггеры срабатывают, но письма не уходят: события
# попадают в журнал уведомлений со статусом «не отправлено».
NOTIFY_RECIPIENTS=
NOTIFY_ADMIN_RECIPIENTS=
