{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oracle-t-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "oracle-t/frontend",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "oracle-t-backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8000"
      ],
      "cwd": "oracle-t/backend",
      "port": 8000
    }
  ]
}
